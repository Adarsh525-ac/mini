# ==============================================================
# CloudTune Backend Environment Configuration Template
# ==============================================================

# Server Port (Cloud Run dynamically injects PORT=8080)
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. https://cloudtune-demo.web.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_STORAGE_BUCKET_NAME=your-cloudtune-media-bucket
ENABLE_GCS_UPLOAD=false

# Google Service Account Credentials
# Option 1: Path to service-account.json file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2: Minified JSON string of the service account key (Ideal for Cloud Run Secret Manager)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}
