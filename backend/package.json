{
  "name": "cloudtune-backend",
  "version": "1.0.0",
  "description": "CloudTune Music Streaming Backend - Google Cloud Platform Cloud Run & Firestore API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:gateway": "node services/api-gateway/src/gateway.js",
    "start:catalog": "node services/catalog-service/src/server.js",
    "start:playlist": "node services/playlist-service/src/server.js",
    "start:user": "node services/user-service/src/server.js",
    "start:admin": "node services/admin-service/src/server.js",
    "test": "node tests/api.test.js",
    "test:microservices": "node tests/microservices.test.js",
    "test:all": "node tests/api.test.js && node tests/microservices.test.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
