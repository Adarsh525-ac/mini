# ==============================================================================
# CloudTune Terraform Configuration Variables Template
# Copy this file to terraform.tfvars and customize with your GCP details:
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# Your Google Cloud Project ID (Required)
project_id = "your-gcp-project-id"

# Primary Google Cloud deployment region
region = "us-central1"

# Service and repository names
service_name  = "cloudtune-api"
repository_id = "cloudtune-repo"
image_tag     = "latest"

# Cloud Run deployment settings
container_port        = 8080
min_instances         = 0
max_instances         = 5
cpu                   = "1"
memory                = "512Mi"
allow_unauthenticated = true
deploy_placeholder    = true
deletion_protection   = false

# Cloud Storage bucket for music & artwork (defaults to "cloudtune-media-<project_id>")
# bucket_name = "cloudtune-media-your-gcp-project-id"
bucket_force_destroy = false

# Firestore database (set to false if already created via Firebase Console)
create_firestore_database = true
firestore_location_id     = "us-central1"
